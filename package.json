{
	"name": "zeldas-per-hour",
	"description": "A website calculating the Zeldas Per Hour (ZPH) of each Nintendo console.",
	"version": "1.0.0",
	"main": "./src/index.html",
	"author": "haykam821",
	"license": "MIT",
	"devDependencies": {
		"@types/debug": "^4.1.7",
		"@types/react": "18.0.25",
		"@types/react-dom": "^18.3.7",
		"@types/styled-components": "^5.1.26",
		"@typescript-eslint/eslint-plugin": "^8.24.0",
		"@typescript-eslint/parser": "^8.24.0",
		"eslint": "^8.57.1",
		"eslint-config-haykam": "^1.23.0",
		"typescript": "^6.0.3",
		"vite": "^6.4.3"
	},
	"scripts": {
		"build": "tsc && vite build",
		"dev": "vite",
		"lint": "eslint \"./**/*.js\" \"./**/*.ts\" \"./**/*.tsx\" --ignore-path .gitignore"
	},
	"dependencies": {
		"debug": "^4.1.1",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"styled-components": "^5.3.6"
	},
	"eslintConfig": {
		"extends": [
			"eslint-config-haykam",
			"plugin:@typescript-eslint/eslint-recommended",
			"plugin:@typescript-eslint/recommended"
		],
		"parser": "@typescript-eslint/parser",
		"plugins": [
			"@typescript-eslint"
		],
		"rules": {
			"no-shadow": "off",
			"@typescript-eslint/no-shadow": "error",
			"sort-imports": "error"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/haykam821/Zeldas-Per-Hour.git"
	},
	"bugs": {
		"url": "https://github.com/haykam821/Zeldas-Per-Hour/issues"
